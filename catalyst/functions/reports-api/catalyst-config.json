{
  "deployment": {
    "stack": "node18",
    "type": "advancedio",
    "function_type": "api",
    "routes": [
      { "path": "/reports/generate", "method": "POST", "function": "index" },
      { "path": "/reports/{id}/download", "method": "GET", "function": "generate-pdf" }
    ],
    "throttling": {
      "enabled": true,
      "rate": {
        "window_ms": 60000,
        "max_requests": 100
      }
    },
    "authentication": {
      "enabled": true,
      "roles": ["SCRB_ADMIN", "DISTRICT_SP", "STATION_SHO", "INVESTIGATOR", "ANALYST"]
    }
  }
}
