{
  "deployment": {
    "stack": "node18",
    "type": "advancedio",
    "function_type": "api",
    "routes": [
      { "path": "/auth/login", "method": "POST", "function": "login" },
      { "path": "/auth/me", "method": "GET", "function": "me" }
    ],
    "throttling": {
      "enabled": true,
      "rate": {
        "window_ms": 60000,
        "max_requests": 20
      }
    }
  }
}
