{
  "project": {
    "name": "ksp-crime-intelligence",
    "type": "web",
    "stack": "node18"
  },
  "deployment": {
    "default": "production",
    "environments": {
      "production": {
        "domain": "ksp-crime.karnataka.gov.in",
        "services": {
          "slate": {
            "build_command": "npm run build && npm run export",
            "output_dir": "client/out"
          },
          "functions": {
            "functions_dir": "functions"
          },
          "appsail": {
            "services_dir": "appsail"
          }
        }
      },
      "staging": {
        "domain": "staging.ksp-crime.karnataka.gov.in"
      }
    }
  },
  "services": {
    "authentication": {
      "type": "hosted",
      "roles": ["SCRB_ADMIN", "DISTRICT_SP", "STATION_SHO", "INVESTIGATOR", "ANALYST"],
      "public_signup": false
    },
    "cache": {
      "tier": "standard"
    },
    "search": {
      "enabled": true,
      "indexes": [
        { "table": "CaseMaster", "columns": ["CrimeNo", "CaseNo", "BriefFacts"] },
        { "table": "Accused", "columns": ["AccusedName"] },
        { "table": "Victim", "columns": ["VictimName"] },
        { "table": "ComplainantDetails", "columns": ["ComplainantName"] },
        { "table": "Unit", "columns": ["UnitName"] },
        { "table": "Employee", "columns": ["FirstName", "KGID"] }
      ]
    },
    "mail": {
      "from_name": "KSP Crime Intelligence",
      "from_email": "noreply@ksp.karnataka.gov.in"
    }
  }
}
